# Copie este arquivo para ".env" e preencha. Nunca compartilhe o .env.

# Banco de dados grátis (Supabase). Sem isto, os dados ficam no arquivo data/db.json
SUPABASE_URL=
SUPABASE_KEY=

# Endereço público do app (no Render é automático; sem barra no final)
PUBLIC_URL=https://seu-app.onrender.com
PORT=3000

# WhatsApp Cloud API (Meta for Developers > seu app > WhatsApp > Configuração da API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=sonhai-segredo-123
WHATSAPP_APP_SECRET=
# Modelo aprovado para lembretes fora da janela de 24h (veja o GUIA, passo 5)
WHATSAPP_TEMPLATE=lembrete_sonhai
WHATSAPP_TEMPLATE_LANG=pt_BR
# Número do Sonhaí que aparece para o cliente (ex.: (16) 99999-0000)
WHATSAPP_NUMERO_EXIBICAO=

# Transcrição dos áudios (platform.openai.com > API keys)
OPENAI_API_KEY=

# Fuso horário dos lembretes
APP_TZ=America/Sao_Paulo

# Chave para testes administrativos (/api/simular e /api/ciclo em produção)
ADMIN_KEY=troque-esta-chave

# Pasta dos dados (use um disco persistente na hospedagem)
DATA_DIR=./data
